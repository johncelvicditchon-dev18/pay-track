rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInCouncil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.council;
    }

    // Student profile documents are keyed by the Firebase Auth UID.
    match /users/{userId} {
      // Any signed-in student can read the registry (used by /accounts).
      // Tighten this to an admin claim if the roster should stay private.
      allow read: if request.auth != null;

      // A student may only create or edit their own profile record.
      allow create, update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;
    }

    // Class list imported from Excel. Document ID = "<council>::<studentId>".
    // Officers only see and change records that belong to their own council.
    match /students/{studentId} {
      allow read: if request.auth != null
        && resource.data.council == signedInCouncil();
      allow create, update: if request.auth != null
        && request.resource.data.council == signedInCouncil();
      allow delete: if request.auth != null
        && resource.data.council == signedInCouncil();
    }

    // Payment records. Document ID = "<council>::<studentId>". Seeded and kept
    // up to date by the Finance Office through the Firebase console (or a
    // trusted admin tool). Officers can only read records from their council.
    match /paymentRecords/{recordId} {
      allow read: if request.auth != null
        && resource.data.council == signedInCouncil();
      allow write: if false;
    }
  }
}
