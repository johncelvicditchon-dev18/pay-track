rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Student profile documents are keyed by the Firebase Auth UID.
    match /users/{userId} {
      // Any signed-in student can read the registry (used by /accounts).
      // Tighten this to an admin claim if the roster should stay private.
      allow read: if request.auth != null;

      // A student may only create or edit their own profile record.
      allow create, update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;
    }

    // Class list imported from Excel. Document ID = normalized Student ID.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Payment records. Document ID = normalized Student ID. Seeded and kept up
    // to date by the Finance Office through the Firebase console (or a trusted
    // admin tool). Signed-in students can look records up by exact Student ID;
    // tighten this to the caller's own record if you add an admin claim.
    match /paymentRecords/{studentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
