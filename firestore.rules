rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInCouncil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.council;
    }

    // Student profile documents are keyed by the Firebase Auth UID.
    match /users/{userId} {
      // Any signed-in student can read the registry (used by /accounts).
      // Tighten this to an admin claim if the roster should stay private.
      allow read: if request.auth != null;

      // A student may only create or edit their own profile record.
      allow create, update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;
    }

    // Class list imported from Excel. Document ID = "<council>::<studentId>".
    // Publicly readable so the student login can match a Student ID to its
    // record; officers can only change records from their own council.
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.council == signedInCouncil();
      allow delete: if request.auth != null
        && resource.data.council == signedInCouncil();
    }

    // Payment types created by officers, e.g.
    // "2ND SEMESTER - 2026-2027 | MEMBERSHIP FEE".
    match /paymentTypes/{typeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.council == signedInCouncil();
      allow delete: if request.auth != null
        && resource.data.council == signedInCouncil();
    }

    // Payment records. Document ID = "<council>::<studentId>". Students look up
    // their own record from the public tracker with just a Student ID, so reads
    // are public. Only officers of that council can add or update charges.
    match /paymentRecords/{recordId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.council == signedInCouncil();
      allow delete: if false;
    }
  }
}
