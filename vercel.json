{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/archive/legacy-static",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/archive/legacy-static/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portal/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
